NEXT_PUBLIC_PIXEL_WORKER_URL=http://localhost:8787/v1/pixelize
# Cloudflare's public testing key. Replace it with your production Turnstile site key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Gemini 与 OpenAI 密钥由用户在页面中填写，不需要配置服务端密钥。
# 可选：独立电脑 GPU 高质量通道，旧版浏览器算法仍为默认。
# 原生开发使用 http://127.0.0.1:8766；Docker 使用 http://host.docker.internal:8766。
# GPU_SERVICE_URL=http://127.0.0.1:8766
# GPU_SERVICE_TOKEN_FILE=E:/project/pindou/services/gpu/.runtime/token.txt
